# Public Supabase connection (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never expose or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical public origin, e.g. https://asar.kz
NEXT_PUBLIC_SITE_URL=

# Optional. Configure the matching Turnstile secret in Supabase Auth dashboard.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Transactional product emails (server only)
RESEND_API_KEY=
EMAIL_FROM=

# Protects /api/cron/* endpoints. Use a long random production secret.
CRON_SECRET=
